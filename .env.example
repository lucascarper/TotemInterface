# ---------- Backend ----------
APP_ENV=development
LOG_LEVEL=INFO

# Banco de dados (dev: SQLite; prod: PostgreSQL)
DATABASE_URL=sqlite:///./totem.db
# DATABASE_URL=postgresql+psycopg://totem:totem@localhost:5432/totem
AUTO_CREATE_SCHEMA=true

# Integração SGG (API v3 — https://app.sgg.net.br/api/v3/doc/)
# SGG_MODE=fake usa um gateway em memória com dados de exemplo (desenvolvimento/testes).
# SGG_MODE=http usa a API real do SGG com a chave abaixo (Basic Auth, senha vazia).
SGG_MODE=fake
SGG_BASE_URL=https://app.sgg.net.br/api/v3/
SGG_API_KEY=cole-aqui-a-chave-de-32-caracteres
SGG_TIMEOUT_SECONDS=15
SYNC_INTERVAL_SECONDS=300

# Inclusão automática no encaixe (só age nas agendas com a opção ligada no painel)
ENCAIXE_AUTO_INTERVAL_SECONDS=300
# Limite de escritas por execução (a API do SGG aceita 60 requisições/min)
ENCAIXE_AUTO_MAX_POR_EXECUCAO=20

# Painel administrativo
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_MINUTES=480

# Totem (opcional): chave simples exigida no header X-Totem-Key
TOTEM_API_KEY=

# CORS (origens do front-end em dev)
CORS_ORIGINS=http://localhost:5173

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000
VITE_TOTEM_API_KEY=
VITE_IDLE_RESET_SECONDS=8
